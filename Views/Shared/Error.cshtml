@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="ae-card text-center mx-auto" style="max-width: 32rem;">
    <div class="mx-auto mb-3 d-flex align-items-center justify-content-center"
         style="width:56px;height:56px;border-radius:50%;background-color:var(--color-danger-light);color:var(--color-danger);font-size:1.6rem;">
        <i class="bi bi-exclamation-triangle-fill"></i>
    </div>
    <h1 class="h3">Something went wrong</h1>
    <p class="text-muted">An unexpected error occurred while processing your request.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Home" asp-action="Index" class="btn btn-primary mt-2">
        <i class="bi bi-house-door me-1"></i>Back to Home
    </a>
</div>
