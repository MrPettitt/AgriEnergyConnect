@model FarmerDashboardViewModel
@{
    ViewData["Title"] = "My Products";
    var farmerName = Model.FarmerName;
}

<div class="ae-page-header">
    <div>
        <div class="ae-eyebrow">Farmer Dashboard</div>
        <h1 class="h3">@(farmerName is not null ? $"Welcome back, {farmerName.Split(' ')[0]}" : "My Products")</h1>
        <p class="text-muted mb-0">Everything you have listed so far.</p>
    </div>
    <a asp-controller="Farmer" asp-action="AddProduct" class="btn btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Product
    </a>
</div>

@if (Model.Products.TotalCount == 0)
{
    <div class="ae-table-card">
        <div class="ae-empty-state">
            <div class="ae-icon"><i class="bi bi-basket"></i></div>
            <h2 class="h5">No products yet</h2>
            <p class="mb-3">Add your first product to see it listed here.</p>
            <a asp-controller="Farmer" asp-action="AddProduct" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i>Add Product
            </a>
        </div>
    </div>
}
else
{
    <div class="ae-table-card">
        <div class="table-responsive">
            <table class="table">
                <thead>
                    <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Production Date</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products.Items)
                    {
                        <tr>
                            <td class="fw-semibold">@product.ProductName</td>
                            <td>
                                <span class="ae-category-badge @(product.ProductCategory == "Fruit" ? "category-fruit" : "")">
                                    @product.ProductCategory
                                </span>
                            </td>
                            <td>@product.Price.ToString("C") <span class="text-muted small">per @product.Unit</span></td>
                            <td>@product.ProductionDate.ToString("d MMM yyyy")</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="EditProduct" asp-route-id="@product.ProductId" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil me-1"></i>Edit
                                </a>
                                <form asp-action="DeleteProduct" asp-route-id="@product.ProductId" method="post" class="d-inline"
                                      data-confirm="Remove @product.ProductName from your listings?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-trash me-1"></i>Delete
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <partial name="_Pager" model="(Model.Products.Page, Model.Products.TotalPages)" />
}
