@model ProductFormViewModel
@{
    ViewData["Title"] = "Edit Product";
}

<div class="ae-page-header">
    <div>
        <div class="ae-eyebrow">Farmer Dashboard</div>
        <h1 class="h3">Edit Product</h1>
        <p class="text-muted mb-0">Update the details of this listing.</p>
    </div>
</div>

<div class="ae-card ae-form-card">
    <form asp-action="EditProduct" asp-route-id="@ViewData["ProductId"]" method="post" novalidate>
        <partial name="_ProductForm" model="Model" />

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-check-lg me-1"></i>Save Changes
            </button>
            <a asp-action="Index" class="btn btn-outline-primary">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
